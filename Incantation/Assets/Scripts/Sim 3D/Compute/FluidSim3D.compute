#pragma use_dxc

#pragma kernel ExternalForces
#pragma kernel InitializeSpacialPartitionBuffers
#pragma kernel CalculateDensities
#pragma kernel CalculatePressureForce
#pragma kernel CalculateViscosity
#pragma kernel UpdatePositions
#pragma kernel CopyBuffer
#pragma kernel InitOriginIndices
#pragma kernel CalcOriginIndices
#pragma kernel CalcAxisAlignedIndices
#pragma kernel BuildNeighborListIndices
#pragma kernel Debug

#define NUM_THREADS							64

//Neighbor search tweakables
#define NEIGHBOR_SEARCH_NUM_THREADS			128
#define NEIGHBOR_SEARCH_SHARED_CACHE_SIZE	(NEIGHBOR_SEARCH_NUM_THREADS)

//Neighbor search derived values
#define NS_MAX_SHARED_MEM_POPULATE_ELEMS	(NEIGHBOR_SEARCH_SHARED_CACHE_SIZE / NEIGHBOR_SEARCH_NUM_THREADS) + ((NEIGHBOR_SEARCH_SHARED_CACHE_SIZE% NEIGHBOR_SEARCH_NUM_THREADS) > 0)

// Includes
#include "./FluidMaths3D.hlsl"
#include "./SpatialHash3D.hlsl"

// Buffers
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float2> Densities; // Density, Near Density

RWStructuredBuffer<float4> DebugValues;

RWStructuredBuffer<uint> keys;							//Sorted key list. Used to construct origin indices.
RWStructuredBuffer<uint> indices;						//Sorted index list. Used to construct origin indices.
RWStructuredBuffer<float3> tempBuffer;					// Used to copy values for memory coalescing
RWStructuredBuffer<uint2> originIndices;				// Holds the locations (start and end indices) in the particle list where particles in each origin cell start and end.
RWStructuredBuffer<uint2> axisAlignedIndices;			// Holds the locations (start and end indices) where sets of 3 axis-aligned neighbor cells have particles in the particle list.
RWStructuredBuffer<uint2> blockNeighborListIndices;		// Holds the locations (start and end indices) for each of 9 axis-aligned neighbor search directions where neighboring particles can be found in the particle list.


// Settings
const uint numParticles;
const uint numCells;

const float gravity;
const float deltaTime;
const float collisionDamping;
const float smoothingRadius;
const float targetDensity;
const float pressureMultiplier;
const float nearPressureMultiplier;
const float viscosityStrength;
const float edgeForce;
const float edgeForceDst;
const int3 boundsSize;
const float cellSize;
const int copyBufferId;			//Position = 0, PredictedPosition = 1, Velocity = 2, Density = 3
const int copyDirection;		//0 = real buffer to temp buffer, 1 = temp buffer to real buffer

const float4x4 localToWorld;
const float4x4 worldToLocal;

const float2 interactionInputPoint;
const float interactionInputStrength;
const float interactionInputRadius;

float PressureFromDensity(float density)
{
	return (density - targetDensity) * pressureMultiplier;
}

float NearPressureFromDensity(float nearDensity)
{
	return nearDensity * nearPressureMultiplier;
}

void ResolveCollisions(uint particleIndex)
{
	// Transform position/velocity to the local space of the bounding box (scale not included)
	float3 posLocal = mul(worldToLocal, float4(Positions[particleIndex], 1)).xyz;
	float3 velocityLocal = mul(worldToLocal, float4(Velocities[particleIndex], 0)).xyz;

	// Calculate distance from box on each axis (negative values are inside box)
	const float3 halfSize = 0.5;
	const float3 edgeDst = halfSize - abs(posLocal);

	// Resolve collisions
	if (edgeDst.x <= 0)
	{
		posLocal.x = halfSize.x * sign(posLocal.x);
		velocityLocal.x *= -1 * collisionDamping;
	}
	if (edgeDst.y <= 0)
	{
		posLocal.y = halfSize.y * sign(posLocal.y);
		velocityLocal.y *= -1 * collisionDamping;
	}
	if (edgeDst.z <= 0)
	{
		posLocal.z = halfSize.z * sign(posLocal.z);
		velocityLocal.z *= -1 * collisionDamping;
	}

	// Transform resolved position/velocity back to world space
	Positions[particleIndex] = mul(localToWorld, float4(posLocal, 1)).xyz;
	Velocities[particleIndex] = mul(localToWorld, float4(velocityLocal, 0)).xyz;

}

[numthreads(NUM_THREADS,1,1)]
void ExternalForces (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	// External forces (gravity)
	Velocities[id.x] += float3(0, gravity, 0) * deltaTime;

	// Predict
	PredictedPositions[id.x] = Positions[id.x] + Velocities[id.x] * 1 / 120.0;
}

[numthreads(NUM_THREADS,1,1)]
void InitializeSpacialPartitionBuffers (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	uint index = id.x;

	// Update index buffer
	int3 cell = GetInBoundsCell(PredictedPositions[index], cellSize, boundsSize);
	uint key = GetKeyFromInBoundsCell(cell, boundsSize);

	keys[index] = key;
	indices[index] = index;
}

[numthreads(NUM_THREADS,1,1)]
void CalculateDensities (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	for (int i = 0; i < 9; i++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 axisNeighborIndices = axisAlignedIndices[key];
		uint startIndex = axisNeighborIndices.x;
		uint endIndex = axisNeighborIndices.y;

		for (uint curIndex = startIndex; curIndex <= endIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

			float dst = sqrt(sqrDstToNeighbour);

			float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
			float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

			// Density Calculation
			float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

			// Accumulation
			density += influenceFactor * densityStrength;
			nearDensity += influenceFactorNear * densityStrength;
		}
	}
	
	Densities[id.x] = float2(density, nearDensity);
}

[numthreads(NUM_THREADS,1,1)]
void CalculatePressureForce (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	// Calculate pressure
	float density = Densities[id.x][0];
	float densityNear = Densities[id.x][1];
	float pressure = PressureFromDensity(density);
	float nearPressure = NearPressureFromDensity(densityNear);
	float3 pressureForce = 0;
	
	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;

	// Neighbour search
	for (int i = 0; i < 9; i ++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 axisNeighborIndices = axisAlignedIndices[key];
		uint startIndex = axisNeighborIndices.x;
		uint endIndex = axisNeighborIndices.y;

		for (uint curIndex = startIndex; curIndex <= endIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];
			float2 neighborDens = Densities[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);
			bool neighborIsNotSelf = (curIndex != id.x);

			float dst = sqrt(sqrDstToNeighbour);
			float3 dir = dst > 0 ? offsetToNeighbour / dst : float3(0, 1, 0);

			float influenceFactor = withinRadius * neighborIsNotSelf * DensityDerivative(dst, smoothingRadius);
			float influenceFactorNear = withinRadius * neighborIsNotSelf * NearDensityDerivative(dst, smoothingRadius);

			// Pressure Calculation
			float densityNeighbour = neighborDens[0];
			float nearDensityNeighbour = neighborDens[1];

			float neighbourPressure = PressureFromDensity(densityNeighbour);
			float neighbourPressureNear = NearPressureFromDensity(nearDensityNeighbour);

			float sharedPressure = (pressure + neighbourPressure) / 2;
			float sharedNearPressure = (nearPressure + neighbourPressureNear) / 2;

			float pressureStrength = sharedPressure / densityNeighbour;
			float nearPressureStrength = sharedNearPressure / nearDensityNeighbour;

			// Accumulation
			pressureForce += dir * influenceFactor * pressureStrength;
			pressureForce += dir * influenceFactorNear * nearPressureStrength;
		}
	}

	float3 acceleration = pressureForce / density;
	Velocities[id.x] += acceleration * deltaTime;
}


[numthreads(NUM_THREADS,1,1)]
void CalculateViscosity (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;
		
	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;

	float3 viscosityForce = 0;
	float3 velocity = Velocities[id.x];

	// Neighbour search
	for (int i = 0; i < 9; i ++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 axisNeighborIndices = axisAlignedIndices[key];
		uint startIndex = axisNeighborIndices.x;
		uint endIndex = axisNeighborIndices.y;

		for (uint curIndex = startIndex; curIndex <= endIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];
			float3 neighbourVelocity = Velocities[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);
			bool neighborIsNotSelf = (curIndex != id.x);

			float dst = sqrt(sqrDstToNeighbour);
			float influenceFactor = withinRadius * neighborIsNotSelf * SmoothingKernelPoly6(dst, smoothingRadius);

			// Viscosity Calculation
			float3 viscosityStrength = (neighbourVelocity - velocity);

			// Accumulation
			viscosityForce += influenceFactor * viscosityStrength;
		}
	}
	Velocities[id.x] += viscosityForce * viscosityStrength * deltaTime;
}

[numthreads(NUM_THREADS, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	Positions[id.x] += Velocities[id.x] * deltaTime;
	ResolveCollisions(id.x);
}

// The branchiness of this kernel is okay because all threads will follow the same branches on a given Dispatch so there will be no divergence
[numthreads(NUM_THREADS, 1, 1)]
void CopyBuffer(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	if (copyDirection == 0)
	{
		// Copy to temp buffer
		uint uncoalescedIndex = indices[id.x];
		if (copyBufferId == 0)
		{
			tempBuffer[id.x] = Positions[uncoalescedIndex];
		} 
		else if (copyBufferId == 1)
		{
			tempBuffer[id.x] = PredictedPositions[uncoalescedIndex];
		}
		else if (copyBufferId == 2)
		{
			tempBuffer[id.x] = Velocities[uncoalescedIndex];
		}
		else if (copyBufferId == 3)
		{
			float2 density = Densities[uncoalescedIndex];
			tempBuffer[id.x] = float3(density[0], density[1], 0.0);
		}
	}
	else
	{
		// Copy from temp buffer
		if (copyBufferId == 0)
		{
			Positions[id.x] = tempBuffer[id.x];
		} 
		else if (copyBufferId == 1)
		{
			PredictedPositions[id.x] = tempBuffer[id.x];
		}
		else if (copyBufferId == 2)
		{
			Velocities[id.x] = tempBuffer[id.x];
		}
		else if (copyBufferId == 3)
		{
			float3 density = tempBuffer[id.x];
			Densities[id.x] = float2(density[0], density[1]);
		}
	}
}

// Reinitialized the array formerly used to store scatter indices for sorting to be the key offset array.
// Each value is a start and end index (inclusive) into the particle-based buffers. 
// 
// If start = end index, that implies there's one particle in the cell. If start = end - 1, there are 2. etc.
// Therefore we initialize this such that start + 1 = end. This implies no particles in the cell (empty).
// 
// We also initialize these to values outside the particle-based buffer's indexable range, so they blow up if 
// consumers don't properly check them before indexing with them (hopefully making bugs more discoverable).
[numthreads(NUM_THREADS, 1, 1)]
void InitOriginIndices(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numCells) { return; }

	originIndices[id.x] = uint2(numParticles + 1, numParticles);
}

// Calculate offsets into the sorted keys buffer (used for spatial hashing).
// For example, given an keys buffer sorted by key like so: {2, 2, 2, 3, 6, 6, 9, 9, 9, 9}
// The resulting Offsets calculated here should be:         {-, -, 0, 3, -, -, 4, -, -, 6}
// (where '-' represents elements that won't be read/written)
// 
// Usage example:
// Say we have a particular particle P, and we want to know which particles are in the same grid cell as it.
// First we would calculate the Key of P based on its position. Let's say in this example that Key = 9.
// Next we can look up originIndices[Key] to get: originIndices[9] = 6
// This tells us that keys[6] is the first particle that's in the same cell as P.
// We follow the same process for finding the index of the last particle in the same cell as P, which would be:
// Given the same keys:                                     {2, 2, 2, 3, 6, 6, 9, 9, 9, 9}
// The resulting ending Offsets calculated here should be:  {-, -, 2, 3, -, -, 5, -, -, 9}
// Now we know the start and end indices of all particles in the same cell as P, and can loop over them.
// 
// We also know how many particles are in the same cell as P, given by: endIndex - startIndex + 1
// 
// NOTE: offsets buffer must filled with that are outside the normal addressable range for this to work properly.
// So this depends on InitOriginIndices being run.
[numthreads(NUM_THREADS, 1, 1)]
void CalcOriginIndices(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) { return; }

	uint i = id.x;

	uint firstParticle = i == 0;
	uint lastParticle = i == (numParticles - 1);

	uint key = keys[i];
	uint keyPrev = keys[i - !firstParticle];
	uint keyNext = keys[i + !lastParticle];

	uint prevKeyMatches = (keyPrev == key) && !firstParticle;
	uint nextKeyMatches = (keyNext == key) && !lastParticle;

	if (!prevKeyMatches)
	{
		originIndices[key].x = i;
	}

	if (!nextKeyMatches)
	{
		originIndices[key].y = i;
	}
}

// Takes advantage of the fact that keys are numbered from with increasing x, then increasing y, then increasing z.
// This allows us to iterate through one (y,z) slice of space while holding x constant for 3 spaces during neighbor
// iteration, reducing the number of random memory accesses from 27 to 9.
//
// For example, for the following cells with start and end particle indices (inclusive), and boundSize.x == 4:
//
// start index:		5	8	13	14	72
// end index:		7	12	13	16	79	...
// cell				0	1	2	3	4
//
// We just carry over the prev and next cell's start and end indices, being mindful of edges. The result will be:
//
// start index:		5	5	8	13	72
// end index:		12	13	16	16	?	...
// cell				0	1	2	3	4
//
// Note that the special case of an empty cell (initialized to start index = numParticles + 1, end index = numParticles)
// Also needs to be accounted for. Note that this method may keep things empty if itself and its direct neighbors are empty.
[numthreads(NUM_THREADS, 1, 1)]
void CalcAxisAlignedIndices(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numCells) { return; }

	uint index = id.x;

	int posInXDim = index % boundsSize.x;
	uint leftBoundaryCell = posInXDim == 0;
	uint rightBoundaryCell = posInXDim == (boundsSize.x - 1);

	uint2 originIndicesArray[3];

	originIndicesArray[0] = originIndices[index - !leftBoundaryCell];
	originIndicesArray[1] = originIndices[index];
	originIndicesArray[2] = originIndices[index + !rightBoundaryCell];

	uint startIndex = numParticles + 1;
	uint endIndex = numParticles;
	uint startIndexEmpty;
	uint endIndexEmpty;

	[unroll]
	for (uint i = 0; i < 3; i++)
	{
		startIndexEmpty = startIndex == numParticles + 1;
		endIndexEmpty = endIndex == numParticles;

		startIndex = startIndex * !startIndexEmpty + startIndexEmpty * originIndicesArray[i].x;
		endIndex = endIndex * !endIndexEmpty + endIndexEmpty * originIndicesArray[2 - i].y;
	}

	uint2 indices = uint2(startIndex, endIndex);
	axisAlignedIndices[index] = indices;
}

groupshared int minStartIndex[NEIGHBOR_SEARCH_NUM_THREADS];
groupshared int maxEndIndex[NEIGHBOR_SEARCH_NUM_THREADS];
groupshared int2 edgesFilledCheck;

// Pre-calculates start & end indices into the particle array for all 9 axis-aligned neighbor directions at the level of a 
// neighbor search thread block.
//
// This enables thread blocks to know in advance the range of particles that need to be searched by all particles within the block,
// which enables them to load particle positions and dependent values in shared memory in parallel to be shared among particles that
// are close by, maximizing use of available bandwidth.
//
// The layout of blockNeighborListIndices in memory is an array of 9 uint2s stored continuously. Each index is a neighbor direction
// (so an index into offsets3D). The x value is the start index and the y value is the end index. If all particles are either 
// out-of-bounds or empty for a block in a given direction, then the x and y values will be set to (numParticles + 1) and numParticles
// respectively, indicating an empty block (just like at the particle-level).
[numthreads(NEIGHBOR_SEARCH_NUM_THREADS, 1, 1)]
void BuildNeighborListIndices(uint3 globalId : SV_DispatchThreadID, uint3 threadId : SV_GroupThreadID, uint3 blockId : SV_GroupID)
{
	uint particleId = (globalId.x >= numParticles) ? numParticles - 1 : globalId.x;

	//SERIALIZED DATA 1: Get key values for each particle.
	uint key = keys[particleId];

	// Calculate some stuff that will be needed later while waiting for data...
	uint localId = threadId.x;
	uint waveSize = WaveGetLaneCount();	
	bool waveLeader = WaveIsFirstLane();

	uint sharedMemAddr = floor(threadId / (float)waveSize);
	uint globalAddrStart = blockId.x * 9;

	uint3 originCell = GetCellFromInBoundsKey(key, boundsSize);

	uint waveReductionCostWorthItThreshold = 2;												//Experimentally-determined
	int individualMinMaxComparisons = NEIGHBOR_SEARCH_NUM_THREADS / waveSize;
	int individualMinMaxIterationsNeeded = firstbithigh(individualMinMaxComparisons);		//ie log2(block thread size / 32)
	bool waveWideReductionNeeded = individualMinMaxIterationsNeeded > waveReductionCostWorthItThreshold;
	int waveWideReductionIterations = waveWideReductionNeeded * ((individualMinMaxComparisons / 32) + ((individualMinMaxComparisons % 32) != 0));
	individualMinMaxComparisons -= waveWideReductionIterations * waveSize;
	individualMinMaxComparisons = max(individualMinMaxComparisons, 0);

	//The third element indicates if we're in-bounds and non-empty. The fourth is the key for this neighbor.
	//The whole point of this variable and the subsequent 2 loops is to ensure near-parallel requests for axisAlignedIndices data.
	uint4 axisAlignedNeighborIndices[9];

	[unroll]
	for (uint initIndex = 0; initIndex < 9; initIndex++)
	{
		axisAlignedNeighborIndices[initIndex].x = numParticles + 1;
		axisAlignedNeighborIndices[initIndex].y = numParticles;

		int3 neighborCell = originCell + offsets3D[initIndex];
		uint inBounds = isCellInBounds(neighborCell, boundsSize);
		uint neighborKey = GetKeyFromInBoundsCell(neighborCell, boundsSize);

		axisAlignedNeighborIndices[initIndex].z = neighborKey;
		axisAlignedNeighborIndices[initIndex].w = inBounds;
	}

	//SERIALIZED DATA 2: Get axis-aligned indices in all 9 neighbor directions (if in-bounds) in parallel
	[unroll]
	for (uint populateIndex = 0; populateIndex < 9; populateIndex++)
	{
		if ((axisAlignedNeighborIndices[populateIndex].w > 0))
		{
			uint key = axisAlignedNeighborIndices[populateIndex].z;
			uint2 indices = axisAlignedIndices[key];
			axisAlignedNeighborIndices[populateIndex].x = indices.x;
			axisAlignedNeighborIndices[populateIndex].y = indices.y;
		}
	}

	//origin cells should always be in-bounds
	if (localId == 0)
	{
		blockNeighborListIndices[globalAddrStart].x = axisAlignedNeighborIndices[0].x;
	}

	if (localId == NEIGHBOR_SEARCH_NUM_THREADS - 1)
	{
		blockNeighborListIndices[globalAddrStart].y = axisAlignedNeighborIndices[0].y;
	}

	//For neighboring cells, determine the first and last in-bounds thread index (if it exists)
	[unroll]
	for (uint curNeighborOffsetIndex = 1; curNeighborOffsetIndex < 9; curNeighborOffsetIndex++)
	{
		uint blockNeighborGlobalMemAddr = globalAddrStart + curNeighborOffsetIndex;
		uint4 curSpannedOffset = axisAlignedNeighborIndices[curNeighborOffsetIndex];

		uint neighborKey = curSpannedOffset.z;
		uint inBounds = curSpannedOffset.w;
		uint isNonEmpty = (curSpannedOffset.y - curSpannedOffset.x + 1) > 0;
		uint nonEmptyInBounds = inBounds * isNonEmpty;

		int realignedStart = nonEmptyInBounds * curSpannedOffset.x + !nonEmptyInBounds * (numParticles + 1);
		int realignedEnd = nonEmptyInBounds * curSpannedOffset.y + !nonEmptyInBounds * -1;

		GroupMemoryBarrierWithGroupSync();

		if (localId == 0)
		{
			edgesFilledCheck.x = realignedStart;
		}

		if (localId == NEIGHBOR_SEARCH_NUM_THREADS - 1)
		{
			edgesFilledCheck.y = realignedEnd;
		}

		GroupMemoryBarrierWithGroupSync();

		//Short circuit for the fully-filled case
		int shortCircuitMin = edgesFilledCheck.x;
		int shortCircuitMax = edgesFilledCheck.y;

		//TODO this works but only if the block size is 32. Why???
		if ((shortCircuitMin < (numParticles + 1)) && (shortCircuitMax > -1))
		{
			if (localId == 0)
			{
				blockNeighborListIndices[blockNeighborGlobalMemAddr].x = shortCircuitMin;
				blockNeighborListIndices[blockNeighborGlobalMemAddr].y = shortCircuitMax;
			}

			continue;
		}

		//Must do max and min index search within thread block. Start with one (assumed) warp-wide min/max.
		int curMin = WaveActiveMin(realignedStart);
		int curMax = WaveActiveMax(realignedEnd);
		uint fullWaveSizeIterations = 1;

		//Warp-wide reductions to do the brunt of the work.
		for (uint warpWideReductionIter = 0; warpWideReductionIter < waveWideReductionIterations; warpWideReductionIter++)
		{
			if (waveLeader)
			{
				minStartIndex[sharedMemAddr] = curMin;
				maxEndIndex[sharedMemAddr] = curMax;
			}

			GroupMemoryBarrierWithGroupSync();

			curMin = minStartIndex[localId];
			curMax = maxEndIndex[localId];

			curMin = WaveActiveMin(curMin);
			curMax = WaveActiveMax(curMax);
			fullWaveSizeIterations++;

			GroupMemoryBarrierWithGroupSync();
		}

		//Leftovers handled in shared memory since it's rather expensive to do a full WaveActiveMin/Max for just a few leftovers.
		for (uint leftoverReductionIter = 1; leftoverReductionIter < individualMinMaxComparisons; leftoverReductionIter *= 2)
		{
			minStartIndex[localId] = curMin;
			maxEndIndex[localId] = curMax;

			uint pullAddr = (localId + leftoverReductionIter * fullWaveSizeIterations * waveSize) % NEIGHBOR_SEARCH_NUM_THREADS;

			GroupMemoryBarrierWithGroupSync();

			int otherMin = minStartIndex[pullAddr];
			int otherMax = maxEndIndex[pullAddr];

			curMin = min(curMin, otherMin);
			curMax = max(curMax, otherMax);

			GroupMemoryBarrierWithGroupSync();
		}

		minStartIndex[localId] = curMin;
		maxEndIndex[localId] = curMax;

		GroupMemoryBarrierWithGroupSync();

		int blockMin = minStartIndex[0];
		int blockMax = maxEndIndex[0];
		blockMax = (blockMax == -1) ? numParticles : blockMax;

		if (localId == 0)
		{
			blockNeighborListIndices[blockNeighborGlobalMemAddr].x = blockMin;
			blockNeighborListIndices[blockNeighborGlobalMemAddr].y = blockMax;
		}
	}
}

float2 CalculateDensitiesExperimental(uint3 id)
{
	if (id.x >= numParticles) return float2(-1, -1);

	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	for (int i = 0; i < 9; i++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 indices = axisAlignedIndices[key];
		uint startIndex = indices.x;
		uint endIndex = indices.y;

		for (uint curIndex = startIndex; curIndex <= endIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

			float dst = sqrt(sqrDstToNeighbour);

			float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
			float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

			// Density Calculation
			float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

			// Accumulation
			density += influenceFactor * densityStrength;
			nearDensity += influenceFactorNear * densityStrength;
		}
	}

	return float2(density, nearDensity);
}

float2 CalculateDensitiesParallel(uint3 id)
{
	uint particleId = floor(id.x / 9);
	uint neighborIndex = id.x % 9;

	if (particleId >= numParticles) return float2(-1, -1);

	float3 pos = PredictedPositions[particleId];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	int3 neighborOriginCell = originCell + offsets3D[neighborIndex];
	bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

	if (!neighborInBounds) return float2(0, 0);

	uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

	uint2 indices = axisAlignedIndices[key];
	uint startIndex = indices.x;
	uint endIndex = indices.y;

	for (uint curIndex = startIndex; curIndex <= endIndex; curIndex++)
	{
		// Dependent Data Retrieval
		float3 neighbourPos = PredictedPositions[curIndex];

		// Influence Calculation
		float3 offsetToNeighbour = neighbourPos - pos;
		float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

		bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

		float dst = sqrt(sqrDstToNeighbour);

		float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
		float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

		// Density Calculation
		float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

		// Accumulation
		density += influenceFactor * densityStrength;
		nearDensity += influenceFactorNear * densityStrength;
	}

	return float2(density, nearDensity);
}

float3 calculateDensityPairwise(float3 pos, float3 neighbourPos)
{
	float sqrRadius = smoothingRadius * smoothingRadius;

	// Influence Calculation
	float3 offsetToNeighbour = neighbourPos - pos;
	float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

	bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

	float dst = sqrt(sqrDstToNeighbour);

	float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
	float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

	// Density Calculation
	float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

	//Density for this pair of particles
	return float3(influenceFactor * densityStrength, influenceFactorNear * densityStrength, 0.0f);
}

groupshared float3 positionsCache[NEIGHBOR_SEARCH_SHARED_CACHE_SIZE];
groupshared float3 depValuesCache[NEIGHBOR_SEARCH_SHARED_CACHE_SIZE];

float3 searchNeighborsInDirectionSharedMemChunk(uint globalId, uint threadBlockId, uint neighborId,
	float3 particlePos, float3 particleDepValue, uint2 sharedMemGlobalIndexRange, uint2 particleGlobalIndexRange)
{
	float3 sum = float3(0, 0, 0);

	//Early exit if no neighbors in this direction
	uint particleNumNeighborsTotal = particleGlobalIndexRange.y - particleGlobalIndexRange.x + 1;
	if (particleNumNeighborsTotal == 0)
	{
		return sum;
	}

	//Early exit if no neighbors in bounds of current section of memory we're checking
	bool2 startIndexOutOfBounds = bool2(particleGlobalIndexRange.x < sharedMemGlobalIndexRange.x, 
		particleGlobalIndexRange.x > sharedMemGlobalIndexRange.y);
	bool2 endIndexOutOfBounds = bool2(particleGlobalIndexRange.y < sharedMemGlobalIndexRange.x,
		particleGlobalIndexRange.y > sharedMemGlobalIndexRange.y);
	bool2 outOfBoundsSameSide = bool2(startIndexOutOfBounds.x && endIndexOutOfBounds.x,
		startIndexOutOfBounds.y && endIndexOutOfBounds.y);
	if (outOfBoundsSameSide.x || outOfBoundsSameSide.y)
	{
		return sum;
	}

	particleGlobalIndexRange.x = clamp(particleGlobalIndexRange.x, sharedMemGlobalIndexRange.x, sharedMemGlobalIndexRange.y);
	particleGlobalIndexRange.y = clamp(particleGlobalIndexRange.y, sharedMemGlobalIndexRange.x, sharedMemGlobalIndexRange.y);

	uint localStartIndex = particleGlobalIndexRange.x - sharedMemGlobalIndexRange.x;
	uint numToCheckInclusive = particleGlobalIndexRange.y - particleGlobalIndexRange.x;
	uint localEndIndex = localStartIndex + numToCheckInclusive;
	
	for (int curIndex = localStartIndex; curIndex <= localEndIndex; curIndex++)
	{
		float3 neighborPos = positionsCache[curIndex];
		sum += calculateDensityPairwise(particlePos, neighborPos);
	}

	return sum;
}

float3 searchNeighborsInDirection(uint globalId, uint threadBlockId, uint neighborId, float3 particlePos,
	float3 particleDepValue, uint2 blockIndices)
{
	float3 sum = float3(0, 0, 0);
	uint blockParticleNum = blockIndices.y - blockIndices.x + 1;

	if (blockParticleNum == 0)
	{
		return sum;
	}

	uint2 particleNeighborIndices = uint2(numParticles + 1, numParticles);
	int3 particleOrigin = GetInBoundsCell(particlePos, cellSize, boundsSize);
	int3 particleNeighborCell = particleOrigin + offsets3D[neighborId];
	bool particleNeighborCellInBounds = isCellInBounds(particleNeighborCell, boundsSize);
	uint particleNeighborCellKey = GetKeyFromInBoundsCell(particleNeighborCell, boundsSize);

	if (particleNeighborCellInBounds)
	{
		particleNeighborIndices = axisAlignedIndices[particleNeighborCellKey];
	}

	uint maxNumElementsToPopulateSharedMem = (NEIGHBOR_SEARCH_SHARED_CACHE_SIZE / NEIGHBOR_SEARCH_NUM_THREADS) +
		((NEIGHBOR_SEARCH_SHARED_CACHE_SIZE % NEIGHBOR_SEARCH_NUM_THREADS) > threadBlockId);

	uint globalMemReads = 0;
	for (int globalMemRound = 0; globalMemRound * NEIGHBOR_SEARCH_SHARED_CACHE_SIZE < blockParticleNum; globalMemRound++)
	{
		uint writtenToSharedMem = 0;
		uint globalMemRoundOffset = blockIndices.x + globalMemRound * NEIGHBOR_SEARCH_SHARED_CACHE_SIZE;

		GroupMemoryBarrierWithGroupSync();

		[unroll]
		for (int sharedMemWriteIndex = 0; sharedMemWriteIndex < NS_MAX_SHARED_MEM_POPULATE_ELEMS; sharedMemWriteIndex++)
		{
			uint localAddrOffset = sharedMemWriteIndex * NEIGHBOR_SEARCH_NUM_THREADS + threadBlockId;
			uint globalAddr = globalMemRoundOffset + localAddrOffset;
			uint sharedMemAddr = localAddrOffset;
			bool shouldPopulate = (globalAddr <= blockIndices.y) && (globalAddr < numParticles) 
				&& (sharedMemWriteIndex <= maxNumElementsToPopulateSharedMem);

			if (shouldPopulate)
			{
				positionsCache[sharedMemAddr] = PredictedPositions[globalAddr];
				//TODO dep values
				writtenToSharedMem++;
			}
		}

		globalMemReads += writtenToSharedMem;

		uint sharedMemGlobalAddrRangeStart = globalMemRoundOffset;
		uint sharedMemGlobalAddrRangeEnd = sharedMemGlobalAddrRangeStart + NEIGHBOR_SEARCH_SHARED_CACHE_SIZE - 1;
		sharedMemGlobalAddrRangeEnd = min(sharedMemGlobalAddrRangeEnd, numParticles - 1);
		uint2 sharedMemGlobalAddrRange = uint2(sharedMemGlobalAddrRangeStart, sharedMemGlobalAddrRangeEnd);

		GroupMemoryBarrierWithGroupSync();

		//Shared memory ready. Do calculations.
		sum += searchNeighborsInDirectionSharedMemChunk(globalId, threadBlockId, neighborId, particlePos,
			particleDepValue, sharedMemGlobalAddrRange, particleNeighborIndices);
	}


	return sum;
}

groupshared uint2 blockIndicesList[9];

float3 searchNeighbors(uint globalId, uint threadId, uint blockId)
{
	uint particleId = min(globalId, numParticles - 1);
	uint blockIndicesListStartAddr = blockId * 9;
	
	//Serialized Global IO 1:
	//		Block-level: Neighbor list indices (all directions)
	//		Particle-level: Position, Dependent Values
	if (threadId < 9)
	{
		blockIndicesList[threadId] = blockNeighborListIndices[blockIndicesListStartAddr + threadId];
	}

	float3 particlePos = PredictedPositions[particleId];
	//TODO read dependent values from global mem
	float3 particleDepValue = float3(0, 0, 0);

	GroupMemoryBarrierWithGroupSync();

	//Serialized Global IO 2-10:
	//		Block-level: All particle positions & dependent values to be shared for this entire block in this direction
	//		Particle-level: Global neighbor list indices for neighbors in this direction
	float3 sum = float3(0, 0, 0);
	for (uint curNeighborDir = 0; curNeighborDir < 9; curNeighborDir++)
	{
		uint2 blockIndicesForDir = blockIndicesList[curNeighborDir];
		sum += searchNeighborsInDirection(globalId, threadId, curNeighborDir,
			particlePos, particleDepValue, blockIndicesForDir);
	}

	return sum;
}

float random(uint seed)
{
	seed ^= 2747636419u;
	seed *= 2654435769u;
	seed ^= seed >> 16;
	seed *= 2246822519u;
	seed ^= seed >> 13;
	seed *= 3266489917u;
	seed ^= seed >> 16;

	// Convert to [0, 1] range
	return frac(float(seed) / 4294967296.0);
}

[numthreads(NEIGHBOR_SEARCH_NUM_THREADS, 1, 1)]
void Debug(uint3 globalId : SV_DispatchThreadID, uint3 threadBlockId : SV_GroupThreadID, uint3 groupID : SV_GroupID)
{
	bool failed = false;

	float2 actualResult = searchNeighbors(globalId.x, threadBlockId.x, groupID.x).xy;

	if (globalId.x >= numParticles) return;

	//float2 expectedResult = CalculateDensitiesExperimental(globalId);

	float floatingPointErrorTolerance = 0.001f;
	//bool resultsMatchish = (abs(actualResult.x - expectedResult.x) <= floatingPointErrorTolerance) &&
	//	(abs(actualResult.y - expectedResult.y) <= floatingPointErrorTolerance);
	//failed = !resultsMatchish;

	uint totalGroups = ceil(numParticles / NEIGHBOR_SEARCH_NUM_THREADS);
	uint maxGroupId = totalGroups - 1;
	float3 randoms;
	//Spreads out colors locally
	uint initialSeed = (groupID.x % 2) * totalGroups + groupID.x;
	randoms.x = random(initialSeed) * failed;
	uint next = round(maxGroupId * randoms.x);
	randoms.y = random(next) * failed;
	next = round(maxGroupId * randoms.y);
	randoms.z = random(next) * failed;

	//DebugValues[globalId.x] = float4(randoms.x, randoms.y, randoms.z, 0.0);
	Densities[globalId.x] = actualResult;
}