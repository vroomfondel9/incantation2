//#pragma use_dxc

#pragma kernel ExternalForces
#pragma kernel InitializeSpacialPartitionBuffers
#pragma kernel CalculateDensities
#pragma kernel CalculatePressureForce
#pragma kernel CalculateViscosity
#pragma kernel UpdatePositions
#pragma kernel CopyBuffer
#pragma kernel InitOffsets
#pragma kernel CalcOffsets
#pragma kernel Debug

#define NUM_THREADS							64
#define NEIGHBOR_SEARCH_NUM_THREADS			64

//Neighbor search defines
//The max number of threads that will coordinate to calculate values for a given origin cell
//A value of 1 should yield identical behavior to the naiive implementation, since there's no coordination
//Any value over 27 would be meaningless because you'd be computing more neighbors than exist simultanously
#define NS_MAX_COORD_BLOCK_SIZE				3		
#define NS_USE_REGISTER_CACHE_POS			1
#define NS_USE_REGISTER_CACHE_SUMS			1

//All of these diagnostic or debug should be commented out in prod
#define NS_DEBUG_ASSISTANCE							//Generally makes debugging easier by doing things like strictly unnecessary cleanup of values
//#define NS_ADDITIONAL_COORDINATOR_CONTEXT			//Adds more data that rides with NSCoordBlock which can help with debugging, but increases register pressure

// Includes
#include "./FluidMaths3D.hlsl"
#include "./SpatialHash3D.hlsl"

// Buffers
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float2> Densities; // Density, Near Density

RWStructuredBuffer<float3> DebugValues;

//Multipurpose spacial partitioning array, to be initialized here but used by sort
RWStructuredBuffer<uint> keys;			//Sorted key list. Used to construct offsets.
RWStructuredBuffer<uint> indices;	//Sorted index list. Used to construct offsets.
RWStructuredBuffer<float3> tempBuffer;	// Used to copy values for memory coalescing
RWStructuredBuffer<uint2> offsets;		// Holds the locations (start and end indices) where origin cell indices are located.

// Settings
const uint numParticles;

const float gravity;
const float deltaTime;
const float collisionDamping;
const float smoothingRadius;
const float targetDensity;
const float pressureMultiplier;
const float nearPressureMultiplier;
const float viscosityStrength;
const float edgeForce;
const float edgeForceDst;
const float3 boundsSize;
const float3 centre;
const int copyBufferId;			//Position = 0, PredictedPosition = 1, Velocity = 2, Density = 3
const int copyDirection;		//0 = real buffer to temp buffer, 1 = temp buffer to real buffer

const float4x4 localToWorld;
const float4x4 worldToLocal;

const float2 interactionInputPoint;
const float interactionInputStrength;
const float interactionInputRadius;

float PressureFromDensity(float density)
{
	return (density - targetDensity) * pressureMultiplier;
}

float NearPressureFromDensity(float nearDensity)
{
	return nearDensity * nearPressureMultiplier;
}

void ResolveCollisions(uint particleIndex)
{
	// Transform position/velocity to the local space of the bounding box (scale not included)
	float3 posLocal = mul(worldToLocal, float4(Positions[particleIndex], 1)).xyz;
	float3 velocityLocal = mul(worldToLocal, float4(Velocities[particleIndex], 0)).xyz;

	// Calculate distance from box on each axis (negative values are inside box)
	const float3 halfSize = 0.5;
	const float3 edgeDst = halfSize - abs(posLocal);

	// Resolve collisions
	if (edgeDst.x <= 0)
	{
		posLocal.x = halfSize.x * sign(posLocal.x);
		velocityLocal.x *= -1 * collisionDamping;
	}
	if (edgeDst.y <= 0)
	{
		posLocal.y = halfSize.y * sign(posLocal.y);
		velocityLocal.y *= -1 * collisionDamping;
	}
	if (edgeDst.z <= 0)
	{
		posLocal.z = halfSize.z * sign(posLocal.z);
		velocityLocal.z *= -1 * collisionDamping;
	}

	// Transform resolved position/velocity back to world space
	Positions[particleIndex] = mul(localToWorld, float4(posLocal, 1)).xyz;
	Velocities[particleIndex] = mul(localToWorld, float4(velocityLocal, 0)).xyz;

}

[numthreads(NUM_THREADS,1,1)]
void ExternalForces (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	// External forces (gravity)
	Velocities[id.x] += float3(0, gravity, 0) * deltaTime;

	// Predict
	PredictedPositions[id.x] = Positions[id.x] + Velocities[id.x] * 1 / 120.0;
}

[numthreads(NUM_THREADS,1,1)]
void InitializeSpacialPartitionBuffers (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	uint index = id.x;

	// Update index buffer
	int3 cell = GetCell3D(PredictedPositions[index], smoothingRadius);
	uint hash = HashCell3D(cell);
	uint key = KeyFromHash(hash, numParticles);

	keys[index] = key;
	indices[index] = index;
}

[numthreads(NUM_THREADS,1,1)]
void CalculateDensities (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetCell3D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	for (int i = 0; i < 27; i++)
	{
		uint hash = HashCell3D(originCell + offsets3D[i]);
		uint key = KeyFromHash(hash, numParticles);

		uint2 keyOffset = offsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		uint curIndex = keyStartIndex;

		while (curIndex < numParticles)
		{
			float3 neighbourPos = PredictedPositions[curIndex];

			int3 neighborCell = GetCell3D(neighbourPos, smoothingRadius);
			uint neighborHash = HashCell3D(neighborCell);

			bool hashMatches = (neighborHash == hash);

			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

			float dst = sqrt(sqrDstToNeighbour);
			density += hashMatches * withinRadius * DensityKernel(dst, smoothingRadius);
			nearDensity += hashMatches * withinRadius * NearDensityKernel(dst, smoothingRadius);

			// Exit if no longer looking at correct bin
			if (curIndex == keyEndIndex) break;
			curIndex++;
		}
	}
	
	Densities[id.x] = float2(density, nearDensity);
}

[numthreads(NUM_THREADS,1,1)]
void CalculatePressureForce (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	// Calculate pressure
	float density = Densities[id.x][0];
	float densityNear = Densities[id.x][1];
	float pressure = PressureFromDensity(density);
	float nearPressure = NearPressureFromDensity(densityNear);
	float3 pressureForce = 0;
	
	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetCell3D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;

	// Neighbour search
	for (int i = 0; i < 27; i ++)
	{
		uint hash = HashCell3D(originCell + offsets3D[i]);
		uint key = KeyFromHash(hash, numParticles);

		uint2 keyOffset = offsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		uint curIndex = keyStartIndex;

		while (curIndex < numParticles)
		{
			float3 neighbourPos = PredictedPositions[curIndex];
			float2 neighborDens = Densities[curIndex];

			int3 neighborCell = GetCell3D(neighbourPos, smoothingRadius);
			uint neighborHash = HashCell3D(neighborCell);

			bool hashMatches = (neighborHash == hash);

			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);
			bool neighborIsNotSelf = (curIndex != id.x);

			// Calculate pressure force
			float densityNeighbour = neighborDens[0];
			float nearDensityNeighbour = neighborDens[1];

			float neighbourPressure = PressureFromDensity(densityNeighbour);
			float neighbourPressureNear = NearPressureFromDensity(nearDensityNeighbour);

			float sharedPressure = (pressure + neighbourPressure) / 2;
			float sharedNearPressure = (nearPressure + neighbourPressureNear) / 2;

			float dst = sqrt(sqrDstToNeighbour);
			float3 dir = dst > 0 ? offsetToNeighbour / dst : float3(0, 1, 0);

			pressureForce += hashMatches * withinRadius * neighborIsNotSelf * dir * DensityDerivative(dst, smoothingRadius) * sharedPressure / densityNeighbour;
			pressureForce += hashMatches * withinRadius * neighborIsNotSelf * dir * NearDensityDerivative(dst, smoothingRadius) * sharedNearPressure / nearDensityNeighbour;

			// Exit if no longer looking at correct bin
			if (curIndex == keyEndIndex) break;
			curIndex++;
		}
	}

	float3 acceleration = pressureForce / density;
	Velocities[id.x] += acceleration * deltaTime;
}


[numthreads(NUM_THREADS,1,1)]
void CalculateViscosity (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;
		
	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetCell3D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;

	float3 viscosityForce = 0;
	float3 velocity = Velocities[id.x];

	// Neighbour search
	for (int i = 0; i < 27; i ++)
	{
		uint hash = HashCell3D(originCell + offsets3D[i]);
		uint key = KeyFromHash(hash, numParticles);

		uint2 keyOffset = offsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		uint curIndex = keyStartIndex;

		while (curIndex < numParticles)
		{
			float3 neighbourPos = PredictedPositions[curIndex];

			int3 neighborCell = GetCell3D(neighbourPos, smoothingRadius);
			uint neighborHash = HashCell3D(neighborCell);

			bool hashMatches = (neighborHash == hash);

			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);
			bool neighborIsNotSelf = (curIndex != id.x);

			// Calculate viscosity
			float dst = sqrt(sqrDstToNeighbour);
			float3 neighbourVelocity = Velocities[curIndex];
			viscosityForce += hashMatches * withinRadius * neighborIsNotSelf * (neighbourVelocity - velocity) * SmoothingKernelPoly6(dst, smoothingRadius);

			// Exit if no longer looking at correct bin
			if (curIndex == keyEndIndex) break;
			curIndex++;
		}
	}
	Velocities[id.x] += viscosityForce * viscosityStrength * deltaTime;
}

[numthreads(NUM_THREADS, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	Positions[id.x] += Velocities[id.x] * deltaTime;
	ResolveCollisions(id.x);
}

// The branchiness of this kernel is okay because all threads will follow the same branches on a given Dispatch so there will be no divergence
[numthreads(NUM_THREADS, 1, 1)]
void CopyBuffer(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	if (copyDirection == 0)
	{
		// Copy to temp buffer
		uint uncoalescedIndex = indices[id.x];
		if (copyBufferId == 0)
		{
			tempBuffer[id.x] = Positions[uncoalescedIndex];
		} 
		else if (copyBufferId == 1)
		{
			tempBuffer[id.x] = PredictedPositions[uncoalescedIndex];
		}
		else if (copyBufferId == 2)
		{
			tempBuffer[id.x] = Velocities[uncoalescedIndex];
		}
		else if (copyBufferId == 3)
		{
			float2 density = Densities[uncoalescedIndex];
			tempBuffer[id.x] = float3(density[0], density[1], 0.0);
		}
	}
	else
	{
		// Copy from temp buffer
		if (copyBufferId == 0)
		{
			Positions[id.x] = tempBuffer[id.x];
		} 
		else if (copyBufferId == 1)
		{
			PredictedPositions[id.x] = tempBuffer[id.x];
		}
		else if (copyBufferId == 2)
		{
			Velocities[id.x] = tempBuffer[id.x];
		}
		else if (copyBufferId == 3)
		{
			float3 density = tempBuffer[id.x];
			Densities[id.x] = float2(density[0], density[1]);
		}
	}
}

// Reinitialized the array formerly used to store scatter indices for sorting to be the key offset array.
// The values are all numParticles (which is 1 more than the maximum possible key) in order to ensure that
// any possible key is not equal to this value. This is important for determing divisions in the key list.
[numthreads(NUM_THREADS, 1, 1)]
void InitOffsets(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) { return; }

	offsets[id.x] = uint2(numParticles, numParticles);
}

// Calculate offsets into the sorted keys buffer (used for spatial hashing).
// For example, given an keys buffer sorted by key like so: {2, 2, 2, 3, 6, 6, 9, 9, 9, 9}
// The resulting Offsets calculated here should be:         {-, -, 0, 3, -, -, 4, -, -, 6}
// (where '-' represents elements that won't be read/written)
// 
// Usage example:
// Say we have a particular particle P, and we want to know which particles are in the same grid cell as it.
// First we would calculate the Key of P based on its position. Let's say in this example that Key = 9.
// Next we can look up offsets[Key] to get: offsets[9] = 6
// This tells us that keys[6] is the first particle that's in the same cell as P.
// We follow the same process for finding the index of the last particle in the same cell as P, which would be:
// Given the same keys:                                     {2, 2, 2, 3, 6, 6, 9, 9, 9, 9}
// The resulting ending Offsets calculated here should be:  {-, -, 2, 3, -, -, 5, -, -, 9}
// Now we know the start and end indices of all particles in the same cell as P, and can loop over them.
// 
// We also know how many particles are in the same cell as P, given by: endIndex - startIndex + 1
// 
// NOTE: offsets buffer must filled with that are outside the normal addressable range for this to work properly.
// So this depends on InitOffsets being run.
[numthreads(NUM_THREADS, 1, 1)]
void CalcOffsets(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) { return; }

	uint i = id.x;

	uint firstParticle = i == 0;
	uint lastParticle = i == (numParticles - 1);

	uint key = keys[i];
	uint keyPrev = keys[i - !firstParticle];
	uint keyNext = keys[i + !lastParticle];

	uint prevKeyMatches = keyPrev == key && !firstParticle;
	uint nextKeyMatches = keyNext == key && !lastParticle;

	if (!prevKeyMatches)
	{
		offsets[key].x = i;
	}

	if (!nextKeyMatches)
	{
		offsets[key].y = i;
	}
}

float2 CalculateDensitiesExperimental(uint3 id)
{
	if (id.x >= numParticles) return float2(-1, -1);

	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetCell3D(pos, smoothingRadius);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	for (int i = 0; i < 27; i++)
	{
		uint hash = HashCell3D(originCell + offsets3D[i]);
		uint key = KeyFromHash(hash, numParticles);

		uint2 keyOffset = offsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		uint curIndex = keyStartIndex;

		while (curIndex < numParticles)
		{
			float3 neighbourPos = PredictedPositions[curIndex];

			int3 neighborCell = GetCell3D(neighbourPos, smoothingRadius);
			uint neighborHash = HashCell3D(neighborCell);

			bool hashMatches = (neighborHash == hash);

			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

			float dst = sqrt(sqrDstToNeighbour);
			density += hashMatches * withinRadius * DensityKernel(dst, smoothingRadius);
			nearDensity += hashMatches * withinRadius * NearDensityKernel(dst, smoothingRadius);

			// Exit if no longer looking at correct bin
			if (curIndex == keyEndIndex) break;
			curIndex++;
		}
	}

	return float2(density, nearDensity);
}

[numthreads(NEIGHBOR_SEARCH_NUM_THREADS, 1, 1)]
void Debug(uint3 globalId : SV_DispatchThreadID, uint3 threadBlockId : SV_GroupThreadID)
{
	if (globalId.x >= numParticles) return;

	float2 actualResult = CalculateDensitiesExperimental(globalId);
	float2 expectedResult = Densities[globalId.x];

	const float floatingPointPrecisionErrorAvoidanceThreshold = 0.0;
	bool failed = (abs(actualResult.x - expectedResult.x) > floatingPointPrecisionErrorAvoidanceThreshold) 
		|| (abs(actualResult.y - expectedResult.y) > floatingPointPrecisionErrorAvoidanceThreshold);

	float testResultFloat = failed;
	DebugValues[globalId.x] = float3(testResultFloat, testResultFloat, testResultFloat);
	//Densities[globalId.x] = actualResult;
}