float3 performNeighborSearchIterationOriginPostEdgeHandlingUncoalesced(uint globalId, uint threadBlockId, out float3 particlePos, out uint3 originCell)
{
	const uint paddingSize = WIDE_MEM_TRANSACTION_SIZE / 2;

	float3 accumulatedDensities = float3(0.0f, 0.0f, 0.0f);

	uint threadBlockGlobalStartIndex = globalId - threadBlockId;

	bool rightSidePadder = threadBlockId >= paddingSize;
	int paddingOffset = (rightSidePadder * 2 - 1) * paddingSize;
	int particleRelativeThreadBlockId = threadBlockId + paddingOffset;
	uint paddedThreadBlockId = paddingSize + particleRelativeThreadBlockId;

	int paddedGlobalId = threadBlockGlobalStartIndex + particleRelativeThreadBlockId;
	bool firstBlock = (paddedGlobalId < 0);
	uint curIndexPadding = !firstBlock * paddingSize;
	uint paddedInBoundsGlobalId = (paddedGlobalId < 0) ? 0 : (uint) paddedGlobalId;
	paddedInBoundsGlobalId = (paddedInBoundsGlobalId >= numParticles) ? numParticles - 1 : paddedInBoundsGlobalId;

	uint nonPaddedInBoundsGlobalId = globalId < numParticles ? globalId : numParticles - 1;

	particlePos = PredictedPositions[nonPaddedInBoundsGlobalId];
	float3 paddingParticle = PredictedPositions[paddedInBoundsGlobalId];
	positionCache[threadBlockId] = particlePos;
	positionCache[paddedThreadBlockId] = paddingParticle;

	originCell = GetInBoundsCell(particlePos, cellSize, boundsSize);

	uint key = GetKeyFromInBoundsCell(originCell, boundsSize);

	uint2 keyOffset = spannedOffsets[key];
	uint keyStartIndex = keyOffset.x;
	uint keyEndIndex = keyOffset.y;

	GroupMemoryBarrierWithGroupSync();

	float3 neighborPos;
	for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
	{
		int curLocalIndex = curIndex - threadBlockGlobalStartIndex + curIndexPadding;
		bool inSharedMem = (curLocalIndex >= 0) && (curLocalIndex < WIDE_MEM_TRANSACTION_SIZE * 2);

		float3 neighborPos = positionCache[curIndex];
		accumulatedDensities += calculateDensityPairwise(particlePos, neighborPos);
	}

	return accumulatedDensities;
}

float3 performNeighborSearchIterationOriginPostEdgeHandling(uint globalId, uint threadBlockId, out float3 particlePos, out uint3 originCell)
{
	const uint paddingSize = WIDE_MEM_TRANSACTION_SIZE / 2;

	float3 accumulatedDensities = float3(0.0f, 0.0f, 0.0f);

	uint threadBlockGlobalStartIndex = globalId - threadBlockId;
	bool firstBlock = threadBlockGlobalStartIndex == 0;

	int leftReadGlobalIndex = globalId - (int)paddingSize;
	uint leftReadInBoundsGlobalIndex = (leftReadGlobalIndex < 0) ? 0 : (uint) leftReadGlobalIndex;

	uint rightReadGlobalIndex = globalId + paddingSize;
	uint rightReadInBoundsGlobalIndex = (rightReadGlobalIndex >= numParticles) ? numParticles - 1 : rightReadGlobalIndex;

	float3 transferPosLeft = PredictedPositions[leftReadGlobalIndex];
	float3 transferPosRight = PredictedPositions[rightReadGlobalIndex];
	positionCache[threadBlockId] = transferPosLeft;
	positionCache[threadBlockId + WIDE_MEM_TRANSACTION_SIZE] = transferPosRight;

	uint paddedLocalId = threadBlockId + paddingSize;

	GroupMemoryBarrierWithGroupSync();

	particlePos = positionCache[paddedLocalId];
	originCell = GetInBoundsCell(particlePos, cellSize, boundsSize);

	uint key = GetKeyFromInBoundsCell(originCell, boundsSize);

	uint2 keyOffset = spannedOffsets[key];
	uint keyStartIndex = keyOffset.x;
	uint keyEndIndex = keyOffset.y;

	int globalOffsets = -1 * (int) threadBlockGlobalStartIndex + paddingSize;
	uint localKeyStartIndex = keyStartIndex + globalOffsets;
	uint localKeyEndIndex = keyEndIndex + globalOffsets;
	uint iterations = localKeyEndIndex - localKeyStartIndex + 1;

	for (uint curLocalIndex = localKeyStartIndex; curLocalIndex <= localKeyEndIndex; curLocalIndex++)
	{
		//bool inSharedMem = (curLocalIndex >= 0) && (curLocalIndex < WIDE_MEM_TRANSACTION_SIZE * 2);

		float3 neighborPos = positionCache[curLocalIndex];
		accumulatedDensities += calculateDensityPairwise(particlePos, neighborPos);
	}

	return accumulatedDensities;
}

float3 performNeighborSearchIterationOrigin(uint globalId, uint threadBlockId, out float3 particlePos, out uint3 originCell)
{
	float3 accumulatedDensities = float3(0.0f, 0.0f, 0.0f);

	uint indexInBoundsGlobalId = globalId < numParticles ? globalId : numParticles - 1;
	uint threadBlockGlobalStartIndex = globalId - threadBlockId;

	particlePos = PredictedPositions[indexInBoundsGlobalId];
	originCell = GetInBoundsCell(particlePos, cellSize, boundsSize);

	uint key = GetKeyFromInBoundsCell(originCell, boundsSize);

	uint2 keyOffset = spannedOffsets[key];
	uint keyStartIndex = keyOffset.x;
	uint keyEndIndex = keyOffset.y;

	float3 neighborPos;
	for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
	{
		float3 neighborPos = PredictedPositions[curIndex];												//Line B
		accumulatedDensities += calculateDensityPairwise(particlePos, neighborPos);
	}

	return accumulatedDensities;
}

// This assumes it's been called after the origin search iteration has already been performed and therefore
// this particle's position, origin cell, and the origin cells of the first and last particles in the thread
// block are known.
//
// This method differs from origin search in the following ways:
//
// First, it can't assume it's in-bounds. But it also can't assume if one thread is out of bounds then all
// must be out of bounds, as a thread block could cross an X boundary and increment Y or Z (for example, 
// from Y = 0 to Y = 1) which would bring out-of-bounds into in-bounds at some unpredictable point. Therefore,
// each thread checks if its offset neighbor cell is in-bounds or not and writes it to shared memory. We then
// search shared memory for the first and last instance of an in-bounds cell and use that as the basis for
// the start and end indices of the neighbor list to search. These indices are retrieved in chunks aligned to
// WIDE_MEM_TRANSACTION_SIZE in order to maximize cache hits. If all cells are out-of-bounds, this returns (0,0,0).
//
// Secondly, the method of search is from left to right, as we don't know which particles to center on for a neighbor
// (this operates starting at the cell-level rather than the particle-level, after all, and each particle maps to
// a neighboring cell but not a neighboring particle). Again, this is aligned to WIDE_MEM_TRANSACTION_SIZE chunks.
float3 performNeighborSearchIterationZYOriginNeighbor(uint globalId, uint threadBlockId, float3 particlePos,
	uint3 originCell, int3 curIterationCellOffset)
{
	return float3(0, 0, 0);
}

float random(uint seed)
{
	seed ^= 2747636419u;
	seed *= 2654435769u;
	seed ^= seed >> 16;
	seed *= 2246822519u;
	seed ^= seed >> 13;
	seed *= 3266489917u;
	seed ^= seed >> 16;

	// Convert to [0, 1] range
	return frac(float(seed) / 4294967296.0);
}

[numthreads(NEIGHBOR_SEARCH_NUM_THREADS, 1, 1)]
void Debug(uint3 globalId : SV_DispatchThreadID, uint3 threadBlockId : SV_GroupThreadID, uint3 groupID : SV_GroupID)
{
	if (globalId.x >= numParticles) return;
	/*float2 expectedResult = CalculateDensitiesExperimental(globalId);

	float3 particlePos;
	uint3 originCell;
	float3 actualResultFloat3 = performNeighborSearchIterationOriginPostEdgeHandling(globalId.x, threadBlockId.x, particlePos, originCell);
	float2 actualResult = float2(actualResultFloat3.x, actualResultFloat3.y);

	const float floatingPointPrecisionErrorAvoidanceThreshold = 0.0005;
	bool failed = (abs(actualResult.x - expectedResult.x) > floatingPointPrecisionErrorAvoidanceThreshold) 
		|| (abs(actualResult.y - expectedResult.y) > floatingPointPrecisionErrorAvoidanceThreshold);*/

	float3 pos = PredictedPositions[globalId.x];
	uint3 origin = GetInBoundsCell(pos, cellSize, boundsSize);

	float3 prevPos = PredictedPositions[globalId.x-1 > 0 ? globalId.x - 1 : 0];
	uint3 prevOrigin = GetInBoundsCell(prevPos, cellSize, boundsSize);

	uint blockStart = globalId.x - threadBlockId.x;
	uint blockEnd = blockStart + NEIGHBOR_SEARCH_NUM_THREADS - 1;

	float3 firstPos = PredictedPositions[blockStart];
	uint3 firstOrigin = GetInBoundsCell(firstPos, cellSize, boundsSize);

	float3 lastPos = PredictedPositions[blockEnd];
	uint3 lastOrigin = GetInBoundsCell(lastPos, cellSize, boundsSize);

	bool failed = false;
	uint2 blockThingy;
	for (int i = 0; i < 9; i++)
	{
		int3 neighborCell = origin + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborCell, boundsSize);

		//int3 prevNeighborOriginCell = prevOrigin + offsets3D[i];
		//bool prevNeighborInBounds = isCellInBounds(prevNeighborOriginCell, boundsSize);

		int3 firstNeighborOriginCell = firstOrigin + offsets3D[i];
		bool firstNeighborInBounds = isCellInBounds(firstNeighborOriginCell, boundsSize);

		int3 lastNeighborOriginCell = lastOrigin + offsets3D[i];
		bool lastNeighborInBounds = isCellInBounds(lastNeighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;
		//if (!prevNeighborInBounds) continue;
		if ((!firstNeighborInBounds) || (!lastNeighborInBounds)) continue;

		uint key = GetKeyFromInBoundsCell(neighborCell, boundsSize);
		uint2 spannedOffset = spannedOffsets[key];

		//uint prevKey = GetKeyFromInBoundsCell(prevNeighborOriginCell, boundsSize);
		//uint2 prevSpannedOffset = spannedOffsets[prevKey];

		uint firstKey = GetKeyFromInBoundsCell(firstNeighborOriginCell, boundsSize);
		uint2 firstSpannedOffset = spannedOffsets[firstKey];

		uint lastKey = GetKeyFromInBoundsCell(lastNeighborOriginCell, boundsSize);
		uint2 lastSpannedOffset = spannedOffsets[lastKey];

		//if ((spannedOffset.x == numParticles + 1) && (spannedOffset.y == numParticles)) continue;
		bool emptyBlock = ((spannedOffset.x == numParticles + 1) && (spannedOffset.y == numParticles));
		bool firstBlockIsEmpty = ((firstSpannedOffset.x == numParticles + 1) && (firstSpannedOffset.y == numParticles));
		bool lastBlockIsEmpty = ((lastSpannedOffset.x == numParticles + 1) && (lastSpannedOffset.y == numParticles));
		//if ((prevSpannedOffset.x == numParticles + 1) && (prevSpannedOffset.y == numParticles)) continue;
		//if ((firstSpannedOffset.x == numParticles + 1) && (firstSpannedOffset.y == numParticles)) continue;
		//if ((lastSpannedOffset.x == numParticles + 1) && (lastSpannedOffset.y == numParticles)) continue;

		//All failures go away if I uncomment out the line checking if firstSpannedOffset is empty.

		blockThingy = blockNeighborIndexBoundaries[9 * groupID.x + i];

		bool myTest = ((blockThingy.y >= spannedOffset.y));// && (blockThingy.y > spannedOffset.y));
		
		failed = failed || (myTest && !emptyBlock);
	}

	//Group ID drill-down
	//failed = failed && (groupID.x < 515) && (groupID.x > 510);

	//Block thingy here was never set/initialized property. It's reading inconsistent values.
	uint totalGroups = ceil(numParticles / NEIGHBOR_SEARCH_NUM_THREADS);
	uint maxGroupId = totalGroups - 1;
	float3 randoms;
	//Spreads out colors locally
	uint initialSeed = (groupID.x % 2) * totalGroups + groupID.x;
	randoms.x = random(initialSeed) * failed;
	uint next = round(maxGroupId * randoms.x);
	randoms.y = random(next) * failed;
	next = round(maxGroupId * randoms.y);
	randoms.z = random(next) * failed;

	DebugValues[globalId.x] = float4(randoms.x, randoms.y, randoms.z, 0.0);
	//Densities[globalId.x] = actualResult;
}