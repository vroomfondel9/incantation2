#pragma use_dxc

#pragma kernel ExternalForces
#pragma kernel InitializeSpacialPartitionBuffers
#pragma kernel CalculateDensities
#pragma kernel CalculatePressureForce
#pragma kernel CalculateViscosity
#pragma kernel UpdatePositions
#pragma kernel CopyBuffer
#pragma kernel InitOffsets
#pragma kernel CalcOffsets
#pragma kernel SpanOffsets
#pragma kernel CalcBlockNeighborOffsets
#pragma kernel Debug

#define NUM_THREADS							64
#define NEIGHBOR_SEARCH_NUM_THREADS			64
#define WIDE_MEM_TRANSACTION_SIZE			128

//Neighbor search defines
//The max number of threads that will coordinate to calculate values for a given origin cell
//A value of 1 should yield identical behavior to the naiive implementation, since there's no coordination
//Any value over 27 would be meaningless because you'd be computing more neighbors than exist simultanously
#define NS_MAX_COORD_BLOCK_SIZE				3		
#define NS_USE_REGISTER_CACHE_POS			1
#define NS_USE_REGISTER_CACHE_SUMS			1

//All of these diagnostic or debug should be commented out in prod
#define NS_DEBUG_ASSISTANCE							//Generally makes debugging easier by doing things like strictly unnecessary cleanup of values
//#define NS_ADDITIONAL_COORDINATOR_CONTEXT			//Adds more data that rides with NSCoordBlock which can help with debugging, but increases register pressure

// Includes
#include "./FluidMaths3D.hlsl"
#include "./SpatialHash3D.hlsl"

// Buffers
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float2> Densities; // Density, Near Density

RWStructuredBuffer<float4> DebugValues;

RWStructuredBuffer<uint> keys;							//Sorted key list. Used to construct offsets.
RWStructuredBuffer<uint> indices;						//Sorted index list. Used to construct offsets.
RWStructuredBuffer<float3> tempBuffer;					// Used to copy values for memory coalescing
RWStructuredBuffer<uint2> offsets;						// Holds the locations (start and end indices) where origin cell indices are located.
RWStructuredBuffer<uint2> spannedOffsets;				// Holds the locations (start and end indices) where sets of 3 spanned adjascent neighbor indices are located
RWStructuredBuffer<uint2> blockNeighborIndexBoundaries;	// Holds the locations (start and end indices) where sets of 3 spanned adjascent neighbor indices are located


// Settings
const uint numParticles;
const uint numCells;

const float gravity;
const float deltaTime;
const float collisionDamping;
const float smoothingRadius;
const float targetDensity;
const float pressureMultiplier;
const float nearPressureMultiplier;
const float viscosityStrength;
const float edgeForce;
const float edgeForceDst;
const int3 boundsSize;
const float cellSize;
const int copyBufferId;			//Position = 0, PredictedPosition = 1, Velocity = 2, Density = 3
const int copyDirection;		//0 = real buffer to temp buffer, 1 = temp buffer to real buffer

const float4x4 localToWorld;
const float4x4 worldToLocal;

const float2 interactionInputPoint;
const float interactionInputStrength;
const float interactionInputRadius;

float PressureFromDensity(float density)
{
	return (density - targetDensity) * pressureMultiplier;
}

float NearPressureFromDensity(float nearDensity)
{
	return nearDensity * nearPressureMultiplier;
}

void ResolveCollisions(uint particleIndex)
{
	// Transform position/velocity to the local space of the bounding box (scale not included)
	float3 posLocal = mul(worldToLocal, float4(Positions[particleIndex], 1)).xyz;
	float3 velocityLocal = mul(worldToLocal, float4(Velocities[particleIndex], 0)).xyz;

	// Calculate distance from box on each axis (negative values are inside box)
	const float3 halfSize = 0.5;
	const float3 edgeDst = halfSize - abs(posLocal);

	// Resolve collisions
	if (edgeDst.x <= 0)
	{
		posLocal.x = halfSize.x * sign(posLocal.x);
		velocityLocal.x *= -1 * collisionDamping;
	}
	if (edgeDst.y <= 0)
	{
		posLocal.y = halfSize.y * sign(posLocal.y);
		velocityLocal.y *= -1 * collisionDamping;
	}
	if (edgeDst.z <= 0)
	{
		posLocal.z = halfSize.z * sign(posLocal.z);
		velocityLocal.z *= -1 * collisionDamping;
	}

	// Transform resolved position/velocity back to world space
	Positions[particleIndex] = mul(localToWorld, float4(posLocal, 1)).xyz;
	Velocities[particleIndex] = mul(localToWorld, float4(velocityLocal, 0)).xyz;

}

[numthreads(NUM_THREADS,1,1)]
void ExternalForces (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	// External forces (gravity)
	Velocities[id.x] += float3(0, gravity, 0) * deltaTime;

	// Predict
	PredictedPositions[id.x] = Positions[id.x] + Velocities[id.x] * 1 / 120.0;
}

[numthreads(NUM_THREADS,1,1)]
void InitializeSpacialPartitionBuffers (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	uint index = id.x;

	// Update index buffer
	int3 cell = GetInBoundsCell(PredictedPositions[index], cellSize, boundsSize);
	uint key = GetKeyFromInBoundsCell(cell, boundsSize);

	keys[index] = key;
	indices[index] = index;
}

[numthreads(NUM_THREADS,1,1)]
void CalculateDensities (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	for (int i = 0; i < 9; i++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 keyOffset = spannedOffsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

			float dst = sqrt(sqrDstToNeighbour);

			float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
			float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

			// Density Calculation
			float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

			// Accumulation
			density += influenceFactor * densityStrength;
			nearDensity += influenceFactorNear * densityStrength;
		}
	}
	
	Densities[id.x] = float2(density, nearDensity);
}

[numthreads(NUM_THREADS,1,1)]
void CalculatePressureForce (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	// Calculate pressure
	float density = Densities[id.x][0];
	float densityNear = Densities[id.x][1];
	float pressure = PressureFromDensity(density);
	float nearPressure = NearPressureFromDensity(densityNear);
	float3 pressureForce = 0;
	
	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;

	// Neighbour search
	for (int i = 0; i < 9; i ++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 keyOffset = spannedOffsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];
			float2 neighborDens = Densities[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);
			bool neighborIsNotSelf = (curIndex != id.x);

			float dst = sqrt(sqrDstToNeighbour);
			float3 dir = dst > 0 ? offsetToNeighbour / dst : float3(0, 1, 0);

			float influenceFactor = withinRadius * neighborIsNotSelf * DensityDerivative(dst, smoothingRadius);
			float influenceFactorNear = withinRadius * neighborIsNotSelf * NearDensityDerivative(dst, smoothingRadius);

			// Pressure Calculation
			float densityNeighbour = neighborDens[0];
			float nearDensityNeighbour = neighborDens[1];

			float neighbourPressure = PressureFromDensity(densityNeighbour);
			float neighbourPressureNear = NearPressureFromDensity(nearDensityNeighbour);

			float sharedPressure = (pressure + neighbourPressure) / 2;
			float sharedNearPressure = (nearPressure + neighbourPressureNear) / 2;

			float pressureStrength = sharedPressure / densityNeighbour;
			float nearPressureStrength = sharedNearPressure / nearDensityNeighbour;

			// Accumulation
			pressureForce += dir * influenceFactor * pressureStrength;
			pressureForce += dir * influenceFactorNear * nearPressureStrength;
		}
	}

	float3 acceleration = pressureForce / density;
	Velocities[id.x] += acceleration * deltaTime;
}


[numthreads(NUM_THREADS,1,1)]
void CalculateViscosity (uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;
		
	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;

	float3 viscosityForce = 0;
	float3 velocity = Velocities[id.x];

	// Neighbour search
	for (int i = 0; i < 9; i ++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 keyOffset = spannedOffsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];
			float3 neighbourVelocity = Velocities[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);
			bool neighborIsNotSelf = (curIndex != id.x);

			float dst = sqrt(sqrDstToNeighbour);
			float influenceFactor = withinRadius * neighborIsNotSelf * SmoothingKernelPoly6(dst, smoothingRadius);

			// Viscosity Calculation
			float3 viscosityStrength = (neighbourVelocity - velocity);

			// Accumulation
			viscosityForce += influenceFactor * viscosityStrength;
		}
	}
	Velocities[id.x] += viscosityForce * viscosityStrength * deltaTime;
}

[numthreads(NUM_THREADS, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	Positions[id.x] += Velocities[id.x] * deltaTime;
	ResolveCollisions(id.x);
}

// The branchiness of this kernel is okay because all threads will follow the same branches on a given Dispatch so there will be no divergence
[numthreads(NUM_THREADS, 1, 1)]
void CopyBuffer(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) return;

	if (copyDirection == 0)
	{
		// Copy to temp buffer
		uint uncoalescedIndex = indices[id.x];
		if (copyBufferId == 0)
		{
			tempBuffer[id.x] = Positions[uncoalescedIndex];
		} 
		else if (copyBufferId == 1)
		{
			tempBuffer[id.x] = PredictedPositions[uncoalescedIndex];
		}
		else if (copyBufferId == 2)
		{
			tempBuffer[id.x] = Velocities[uncoalescedIndex];
		}
		else if (copyBufferId == 3)
		{
			float2 density = Densities[uncoalescedIndex];
			tempBuffer[id.x] = float3(density[0], density[1], 0.0);
		}
	}
	else
	{
		// Copy from temp buffer
		if (copyBufferId == 0)
		{
			Positions[id.x] = tempBuffer[id.x];
		} 
		else if (copyBufferId == 1)
		{
			PredictedPositions[id.x] = tempBuffer[id.x];
		}
		else if (copyBufferId == 2)
		{
			Velocities[id.x] = tempBuffer[id.x];
		}
		else if (copyBufferId == 3)
		{
			float3 density = tempBuffer[id.x];
			Densities[id.x] = float2(density[0], density[1]);
		}
	}
}

// Reinitialized the array formerly used to store scatter indices for sorting to be the key offset array.
// Each value is a start and end index (inclusive) into the particle-based buffers. 
// 
// If start = end index, that implies there's one particle in the cell. If start = end - 1, there are 2. etc.
// Therefore we initialize this such that start + 1 = end. This implies no particles in the cell (empty).
// 
// We also initialize these to values outside the particle-based buffer's indexable range, so they blow up if 
// consumers don't properly check them before indexing with them (hopefully making bugs more discoverable).
[numthreads(NUM_THREADS, 1, 1)]
void InitOffsets(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numCells) { return; }

	offsets[id.x] = uint2(numParticles + 1, numParticles);
}

// Calculate offsets into the sorted keys buffer (used for spatial hashing).
// For example, given an keys buffer sorted by key like so: {2, 2, 2, 3, 6, 6, 9, 9, 9, 9}
// The resulting Offsets calculated here should be:         {-, -, 0, 3, -, -, 4, -, -, 6}
// (where '-' represents elements that won't be read/written)
// 
// Usage example:
// Say we have a particular particle P, and we want to know which particles are in the same grid cell as it.
// First we would calculate the Key of P based on its position. Let's say in this example that Key = 9.
// Next we can look up offsets[Key] to get: offsets[9] = 6
// This tells us that keys[6] is the first particle that's in the same cell as P.
// We follow the same process for finding the index of the last particle in the same cell as P, which would be:
// Given the same keys:                                     {2, 2, 2, 3, 6, 6, 9, 9, 9, 9}
// The resulting ending Offsets calculated here should be:  {-, -, 2, 3, -, -, 5, -, -, 9}
// Now we know the start and end indices of all particles in the same cell as P, and can loop over them.
// 
// We also know how many particles are in the same cell as P, given by: endIndex - startIndex + 1
// 
// NOTE: offsets buffer must filled with that are outside the normal addressable range for this to work properly.
// So this depends on InitOffsets being run.
[numthreads(NUM_THREADS, 1, 1)]
void CalcOffsets(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numParticles) { return; }

	uint i = id.x;

	uint firstParticle = i == 0;
	uint lastParticle = i == (numParticles - 1);

	uint key = keys[i];
	uint keyPrev = keys[i - !firstParticle];
	uint keyNext = keys[i + !lastParticle];

	uint prevKeyMatches = (keyPrev == key) && !firstParticle;
	uint nextKeyMatches = (keyNext == key) && !lastParticle;

	if (!prevKeyMatches)
	{
		offsets[key].x = i;
	}

	if (!nextKeyMatches)
	{
		offsets[key].y = i;
	}
}

// Takes advantage of the fact that keys are numbered from with increasing x, then increasing y, then increasing z.
// This allows us to iterate through one (y,z) slice of space while holding x constant for 3 spaces during neighbor
// iteration, reducing the number of random memory accesses from 27 to 9.
//
// For example, for the following cells with start and end particle indices (inclusive), and boundSize.x == 4:
//
// start index:		5	8	13	14	72
// end index:		7	12	13	16	79	...
// cell				0	1	2	3	4
//
// We just carry over the prev and next cell's start and end indices, being mindful of edges. The result will be:
//
// start index:		5	5	8	13	72
// end index:		12	13	16	16	?	...
// cell				0	1	2	3	4
//
// Note that the special case of an empty cell (initialized to start index = numParticles + 1, end index = numParticles)
// Also needs to be accounted for. Note that this method may keep things empty if itself and its direct neighbors are empty.
[numthreads(NUM_THREADS, 1, 1)]
void SpanOffsets(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= numCells) { return; }

	uint index = id.x;

	int posInXDim = index % boundsSize.x;
	uint leftBoundaryCell = posInXDim == 0;
	uint rightBoundaryCell = posInXDim == (boundsSize.x - 1);

	uint2 offsetsArray[3];

	offsetsArray[0] = offsets[index - !leftBoundaryCell];
	offsetsArray[1] = offsets[index];
	offsetsArray[2] = offsets[index + !rightBoundaryCell];

	uint startIndex = numParticles + 1;
	uint endIndex = numParticles;
	uint startIndexEmpty;
	uint endIndexEmpty;

	[unroll]
	for (uint i = 0; i < 3; i++)
	{
		startIndexEmpty = startIndex == numParticles + 1;
		endIndexEmpty = endIndex == numParticles;

		startIndex = startIndex * !startIndexEmpty + startIndexEmpty * offsetsArray[i].x;
		endIndex = endIndex * !endIndexEmpty + endIndexEmpty * offsetsArray[2 - i].y;
	}

	uint2 spannedOffset = uint2(startIndex, endIndex);
	spannedOffsets[index] = spannedOffset;
}

groupshared int minStartIndex[NEIGHBOR_SEARCH_NUM_THREADS];
groupshared int maxEndIndex[NEIGHBOR_SEARCH_NUM_THREADS];

//JWB
[numthreads(NEIGHBOR_SEARCH_NUM_THREADS, 1, 1)]
void CalcBlockNeighborOffsets(uint3 globalId : SV_DispatchThreadID, uint3 threadId : SV_GroupThreadID, uint3 blockId : SV_GroupID)
{
	uint particleId = (globalId.x >= numParticles) ? numParticles - 1 : globalId.x;
	uint localId = threadId.x;
	uint globalAddrStart = blockId.x * 9;

	uint waveSize = WaveGetLaneCount();
	uint reductionMax = NEIGHBOR_SEARCH_NUM_THREADS / waveSize;

	uint key = keys[particleId];
	uint3 originCell = GetCellFromInBoundsKey(key, boundsSize);

	//The third element indicates if we're in-bounds and non-empty. The fourth is the key for this neighbor.
	uint4 spannedOffsetAllNeighbors[9];

	[unroll]
	for (uint initIndex = 0; initIndex < 9; initIndex++)
	{
		spannedOffsetAllNeighbors[initIndex].x = numParticles + 1;
		spannedOffsetAllNeighbors[initIndex].y = numParticles;

		int3 neighborCell = originCell + offsets3D[initIndex];
		uint inBounds = isCellInBounds(neighborCell, boundsSize);
		uint neighborKey = GetKeyFromInBoundsCell(neighborCell, boundsSize);

		spannedOffsetAllNeighbors[initIndex].z = neighborKey;
		spannedOffsetAllNeighbors[initIndex].w = inBounds;
	}

	[unroll]
	for (uint populateIndex = 0; populateIndex < 9; populateIndex++)
	{
		if ((populateIndex != 0) && (spannedOffsetAllNeighbors[populateIndex].w > 0))
		{
			uint key = spannedOffsetAllNeighbors[populateIndex].z;
			uint2 spannedOff = spannedOffsets[key];
			spannedOffsetAllNeighbors[populateIndex].x = spannedOff.x;
			spannedOffsetAllNeighbors[populateIndex].y = spannedOff.y;
		}
	}

	//origin cells should always be in-bounds
	if (localId == 0)
	{
		blockNeighborIndexBoundaries[globalAddrStart].x = spannedOffsets[key].x;
	}

	if (localId == NEIGHBOR_SEARCH_NUM_THREADS - 1)
	{
		blockNeighborIndexBoundaries[globalAddrStart].y = spannedOffsets[key].y;
	}

	//For neighboring cells, determine the first and last in-bounds thread index (if it exists)
	[unroll]
	for (uint curNeighborOffsetIndex = 1; curNeighborOffsetIndex < 9; curNeighborOffsetIndex++)
	{
		//Step 1: 0 if out-of-bounds, 1 if in-bounds
		uint blockNeighborGlobalMemAddr = globalAddrStart + curNeighborOffsetIndex;
		uint4 curSpannedOffset = spannedOffsetAllNeighbors[curNeighborOffsetIndex];

		uint neighborKey = curSpannedOffset.z;
		uint inBounds = curSpannedOffset.w;
		uint isEmpty = (curSpannedOffset.y - curSpannedOffset.x + 1) > 0;
		uint nonEmptyInBounds = inBounds * isEmpty;

		//Must do max and min index search within thread
		int realignedStart = nonEmptyInBounds * localId + !nonEmptyInBounds * NEIGHBOR_SEARCH_NUM_THREADS;
		int realignedEnd = nonEmptyInBounds * localId + !nonEmptyInBounds * -1;

		minStartIndex[localId] = realignedStart;
		maxEndIndex[localId] = realignedEnd;
		GroupMemoryBarrierWithGroupSync();

		//Short circuit for the fully-filled case
		int shortCircuitMin = minStartIndex[0];
		int shortCircuitMax = maxEndIndex[NEIGHBOR_SEARCH_NUM_THREADS - 1];

		if ((shortCircuitMin < NEIGHBOR_SEARCH_NUM_THREADS) && (shortCircuitMax > -1))
		{
			if (localId == shortCircuitMin)
			{
				blockNeighborIndexBoundaries[blockNeighborGlobalMemAddr].x = curSpannedOffset.x;
			}

			if (localId == shortCircuitMax)
			{
				blockNeighborIndexBoundaries[blockNeighborGlobalMemAddr].y = curSpannedOffset.y;
			}

			continue;
		}

		//Must do max and min index search within thread
		int curMin = WaveActiveMin(realignedStart);
		int curMax = WaveActiveMax(realignedEnd);

		//Step 2: Perform Prefix 
		for (uint prefIter = 1; prefIter < reductionMax; prefIter *= 2)
		{
			minStartIndex[localId] = curMin;
			maxEndIndex[localId] = curMax;

			int pullIndex = localId - prefIter * waveSize;
			bool shouldPull = pullIndex >= 0;

			GroupMemoryBarrierWithGroupSync();

			int otherMinValue = shouldPull ? minStartIndex[pullIndex] : NEIGHBOR_SEARCH_NUM_THREADS;
			int otherMaxValue = shouldPull ? maxEndIndex[pullIndex] : -1;

			curMin = min(curMin, otherMinValue);
			curMax = max(curMax, otherMaxValue);

			GroupMemoryBarrierWithGroupSync();
		}

		minStartIndex[localId] = curMin;
		maxEndIndex[localId] = curMax;

		GroupMemoryBarrierWithGroupSync();

		uint blockMin = minStartIndex[NEIGHBOR_SEARCH_NUM_THREADS - 1];
		uint blockMax = maxEndIndex[NEIGHBOR_SEARCH_NUM_THREADS - 1];

		if (localId == blockMin)
		{
			blockNeighborIndexBoundaries[blockNeighborGlobalMemAddr].x = curSpannedOffset.x;
		}

		if (localId == blockMax)
		{
			blockNeighborIndexBoundaries[blockNeighborGlobalMemAddr].y = curSpannedOffset.y;
		}

		if (localId == 0)
		{
			if ((blockMin < 0) || (blockMin >= NEIGHBOR_SEARCH_NUM_THREADS))
			{
				blockNeighborIndexBoundaries[blockNeighborGlobalMemAddr].x = numParticles + 1;
			}

			if ((blockMax < 0) || (blockMax >= NEIGHBOR_SEARCH_NUM_THREADS))
			{
				blockNeighborIndexBoundaries[blockNeighborGlobalMemAddr].y = numParticles;
			}
		}
	}
}

float2 CalculateDensitiesExperimental(uint3 id)
{
	if (id.x >= numParticles) return float2(-1, -1);

	float3 pos = PredictedPositions[id.x];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	for (int i = 0; i < 1; i++)
	{
		int3 neighborOriginCell = originCell + offsets3D[i];
		bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

		if (!neighborInBounds) continue;

		uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

		uint2 keyOffset = spannedOffsets[key];
		uint keyStartIndex = keyOffset.x;
		uint keyEndIndex = keyOffset.y;

		for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
		{
			// Dependent Data Retrieval
			float3 neighbourPos = PredictedPositions[curIndex];

			// Influence Calculation
			float3 offsetToNeighbour = neighbourPos - pos;
			float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

			bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

			float dst = sqrt(sqrDstToNeighbour);

			float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
			float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

			// Density Calculation
			float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

			// Accumulation
			density += influenceFactor * densityStrength;
			nearDensity += influenceFactorNear * densityStrength;
		}
	}

	return float2(density, nearDensity);
}

float2 CalculateDensitiesParallel(uint3 id)
{
	uint particleId = floor(id.x / 9);
	uint neighborIndex = id.x % 9;

	if (particleId >= numParticles) return float2(-1, -1);

	float3 pos = PredictedPositions[particleId];
	int3 originCell = GetInBoundsCell(pos, cellSize, boundsSize);
	float sqrRadius = smoothingRadius * smoothingRadius;
	float density = 0;
	float nearDensity = 0;

	// Neighbour search
	int3 neighborOriginCell = originCell + offsets3D[neighborIndex];
	bool neighborInBounds = isCellInBounds(neighborOriginCell, boundsSize);

	if (!neighborInBounds) return float2(-1, -1);

	uint key = GetKeyFromInBoundsCell(neighborOriginCell, boundsSize);

	uint2 keyOffset = spannedOffsets[key];
	uint keyStartIndex = keyOffset.x;
	uint keyEndIndex = keyOffset.y;

	for (uint curIndex = keyStartIndex; curIndex <= keyEndIndex; curIndex++)
	{
		// Dependent Data Retrieval
		float3 neighbourPos = PredictedPositions[curIndex];

		// Influence Calculation
		float3 offsetToNeighbour = neighbourPos - pos;
		float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

		bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

		float dst = sqrt(sqrDstToNeighbour);

		float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
		float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

		// Density Calculation
		float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

		// Accumulation
		density += influenceFactor * densityStrength;
		nearDensity += influenceFactorNear * densityStrength;
	}

	return float2(density, nearDensity);
}

float3 calculateDensityPairwise(float3 pos, float3 neighbourPos)
{
	float sqrRadius = smoothingRadius * smoothingRadius;

	// Influence Calculation
	float3 offsetToNeighbour = neighbourPos - pos;
	float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

	bool withinRadius = (sqrDstToNeighbour <= sqrRadius);

	float dst = sqrt(sqrDstToNeighbour);

	float influenceFactor = withinRadius * DensityKernel(dst, smoothingRadius);
	float influenceFactorNear = withinRadius * NearDensityKernel(dst, smoothingRadius);

	// Density Calculation
	float densityStrength = 1.0;			//Each particle has an assumed mass of 1 (for now)

	//Density for this pair of particles
	return float3(influenceFactor * densityStrength, influenceFactorNear * densityStrength, 0.0f);
}

//groupshared float3 positionCache[WIDE_MEM_TRANSACTION_SIZE];
groupshared float3 positionCache[WIDE_MEM_TRANSACTION_SIZE * 2];

